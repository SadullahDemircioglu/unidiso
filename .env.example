# Kopyalayıp .env adıyla kaydedin: cp .env.example .env
# Yerel test portu (http://localhost:8090)
WEB_PORT=8090

# Gmail SMTP — Google hesabında 2 adımlı doğrulama açık olmalı,
# şifre yerine "Uygulama şifresi" kullanılır: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@unidiso.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=Unidiso <info@unidiso.com>
MAIL_TO=info@unidiso.com

# İsteğe bağlı
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
