# SMTP (zorunlu — e-posta göndermek için)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@unidiso.com
SMTP_PASS=uygulama-sifresi
MAIL_FROM=Unidiso <info@unidiso.com>
MAIL_TO=info@unidiso.com

# İsteğe bağlı anlık bildirimler
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# Site farklı bir domain'deyse (normalde gerekmez)
ALLOWED_ORIGIN=*
PORT=3000

# Cloudflare Turnstile gizli anahtarı (boşsa captcha doğrulaması kapalı)
# Yerel test: 1x0000000000000000000000000000000AA (her zaman geçer)
TURNSTILE_SECRET=
